{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": " ❯ ",
    "color": {
      "keys": "red",
      "title": "red"
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[1;31m╔══════════════════════════════════════════════════════╗\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[1;31m║  🎭  TAKE YOUR HEART // PHANTOMSHELL CALLING CARD    ║\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[1;31m╚══════════════════════════════════════════════════════╝\u001b[0m"
    },
    "title",
    "separator",
    { "type": "os",       "key": "★ METAVERSE OS" },
    { "type": "kernel",   "key": "★ KERNEL      " },
    { "type": "wm",       "key": "★ COMPOSITOR  " },
    { "type": "shell",    "key": "★ SHELL       " },
    { "type": "terminal", "key": "★ TERMINAL    " },
    { "type": "cpu",      "key": "★ KNOWLEDGE   " },
    { "type": "gpu",      "key": "★ PROFICIENCY " },
    { "type": "memory",   "key": "★ GUTS (RAM)  " },
    { "type": "uptime",   "key": "★ DARK HOUR   " },
    "break",
    "colors"
  ]
}

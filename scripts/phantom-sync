#!/usr/bin/env bash
set -euo pipefail

# penentuan direktori repositori sumber phantomshell
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
DOTS_SRC="$REPO_ROOT/dots"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}"
NIXOS_DOTS="/etc/nixos/dotfiles"

cmd="${1:-help}"

emit() { printf '%s\n' "$1"; }

# fungsi bantu sinkronisasi satu bundel direktori konfigurasi
sync_bundle() {
    local dest="$1"
    emit "SYNC_START|Syncing dots ke ${dest}..."

    for sub in quickshell hypr kitty phantomshell matugen cava; do
        if [ -L "$dest/$sub" ]; then
            emit "SYNC_SKIP|${dest}/${sub} adalah symlink nix-store (dilewati, disinkronkan via /etc/nixos/dotfiles)"
            continue
        fi
        mkdir -p "$dest/$sub"
        local flags="-a"
        [ "$sub" = "quickshell" ] && flags="-a --delete"
        if rsync $flags "$DOTS_SRC/$sub/" "$dest/$sub/" 2>&1 | head -n 20 | while IFS= read -r l; do emit "SYNC_LOG|$l"; done; then
            emit "SYNC_OK|${sub} -> ${dest}/${sub}"
        else
            emit "SYNC_WARN|${sub} rsync warning pada ${dest}"
        fi
    done
}

case "$cmd" in
    check-remote)
        cd "$REPO_ROOT"
        git fetch origin main --quiet 2>/dev/null || { emit "ERR|Gagal fetch remote"; exit 0; }
        LOCAL=$(git rev-parse HEAD 2>/dev/null)
        REMOTE=$(git rev-parse origin/main 2>/dev/null)
        BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
        AHEAD=$(git rev-list origin/main..HEAD --count 2>/dev/null || echo 0)
        BEHIND=$(git rev-list HEAD..origin/main --count 2>/dev/null || echo 0)
        COMMIT_MSG=$(git log -1 --format='%s' origin/main 2>/dev/null | head -c 80)
        DATE=$(git log -1 --format='%ar' origin/main 2>/dev/null)
        emit "REMOTE_CHECK|${BRANCH}|${LOCAL:0:7}|${REMOTE:0:7}|${AHEAD}|${BEHIND}|${COMMIT_MSG}|${DATE}"
        ;;

    pull)
        cd "$REPO_ROOT"
        BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
        BEFORE=$(git rev-parse HEAD 2>/dev/null)
        emit "PULL_START|Fetching latest commits from origin/${BRANCH}..."
        if ! git pull --rebase origin "$BRANCH" 2>&1 | while IFS= read -r line; do emit "PULL_LOG|${line}"; done; then
            emit "ERR|git pull gagal, cek koneksi atau ada conflict"
            exit 0
        fi
        AFTER=$(git rev-parse HEAD 2>/dev/null)
        if [ "$BEFORE" = "$AFTER" ]; then
            emit "PULL_DONE|ALREADY_LATEST|Udah di commit terbaru: ${AFTER:0:7}"
        else
            COUNT=$(git rev-list "${BEFORE}..${AFTER}" --count 2>/dev/null || echo 1)
            NEWMSG=$(git log -1 --format='%s' 2>/dev/null | head -c 80)
            emit "PULL_DONE|UPDATED|${COUNT} commit baru • ${AFTER:0:7} • ${NEWMSG}"
        fi
        ;;

    sync)
        CUSTOM_TARGET="${2:-}"
        if [ -n "$CUSTOM_TARGET" ]; then
            sync_bundle "$CUSTOM_TARGET"
        else
            # sinkronisasi ke /etc/nixos/dotfiles jika tersedia dan dapat ditulis
            if [ -d "$NIXOS_DOTS" ] && [ -w "$NIXOS_DOTS" ]; then
                sync_bundle "$NIXOS_DOTS"
            fi

            # sinkronisasi ke ~/.config untuk setiap folder yang bukan symlink nix-store
            if [ -w "$CONFIG_DIR" ]; then
                sync_bundle "$CONFIG_DIR"
            fi
        fi

        # pasang kursor persona5-animated dan skrip cli ke direktori lokal pengguna
        mkdir -p "$HOME/.local/share/icons" "$HOME/.local/bin"
        rsync -a "$DOTS_SRC/icons/Persona5-Animated" "$HOME/.local/share/icons/" 2>/dev/null || true
        ln -sf "$REPO_ROOT/scripts/phantomshell" "$HOME/.local/bin/phantomshell"
        ln -sf "$REPO_ROOT/scripts/phantom-sync" "$HOME/.local/bin/phantom-sync"
        emit "SYNC_OK|CLI & Persona5-Animated cursors installed to ~/.local"
        emit "SYNC_DONE|Sinkronisasi selesai"
        ;;

    pull-sync)
        TARGET="${2:-}"
        "$0" pull
        if [ -n "$TARGET" ]; then
            "$0" sync "$TARGET"
        else
            "$0" sync
        fi
        emit "RELOAD_START|Reloading Hyprland config..."
        hyprctl reload >/dev/null 2>&1 || true
        emit "RELOAD_DONE|Phantomshell berhasil disinkronkan"
        ;;

    status)
        cd "$REPO_ROOT"
        BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
        COMMIT=$(git rev-parse HEAD 2>/dev/null)
        DIRTY=$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')
        MSG=$(git log -1 --format='%s' 2>/dev/null | head -c 80)
        DATE=$(git log -1 --format='%ar' origin/main 2>/dev/null || git log -1 --format='%ar' 2>/dev/null)
        emit "STATUS|${BRANCH}|${COMMIT:0:7}|${DIRTY}|${MSG}|${DATE}"
        ;;

    *)
        cat <<EOF
phantom-sync — phantomshell updater & sync tool
usage:
  phantom-sync status           tampilkan git status repo
  phantom-sync check-remote     cek update di github tanpa pull
  phantom-sync pull             tarik commit terbaru (git pull --rebase)
  phantom-sync sync [target]    rsync dots/ ke /etc/nixos/dotfiles & ~/.config
  phantom-sync pull-sync        pull + sync sekaligus
EOF
        ;;
esac

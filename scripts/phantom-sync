#!/usr/bin/env bash
set -euo pipefail

# direktori repo sumber phantomshell
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
DOTS_SRC="$REPO_ROOT/dots"

# target direktori config sistem
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}"

# perintah utama: check | sync | pull | pull-sync | status
cmd="${1:-help}"

# tulis baris tunggal ke stdout agar QML bisa parse via SplitParser
emit() { printf '%s\n' "$1"; }

case "$cmd" in
    # cek apakah ada update di remote tanpa fetch destructive
    check-remote)
        cd "$REPO_ROOT"
        git fetch origin main --quiet 2>/dev/null || { emit "ERR|Gagal fetch remote"; exit 0; }
        LOCAL=$(git rev-parse HEAD 2>/dev/null)
        REMOTE=$(git rev-parse origin/main 2>/dev/null)
        BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
        AHEAD=$(git rev-list origin/main..HEAD --count 2>/dev/null || echo 0)
        BEHIND=$(git rev-list HEAD..origin/main --count 2>/dev/null || echo 0)
        COMMIT_MSG=$(git log -1 --format='%s' origin/main 2>/dev/null | head -c 80)
        DATE=$(git log -1 --format='%ar' origin/main 2>/dev/null)
        emit "REMOTE_CHECK|${BRANCH}|${LOCAL:0:7}|${REMOTE:0:7}|${AHEAD}|${BEHIND}|${COMMIT_MSG}|${DATE}"
        ;;

    # tarik update terbaru dari github
    pull)
        cd "$REPO_ROOT"
        BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
        BEFORE=$(git rev-parse HEAD 2>/dev/null)
        emit "PULL_START|Fetching latest commits from origin/${BRANCH}..."
        if ! git pull --rebase origin "$BRANCH" 2>&1 | while IFS= read -r line; do emit "PULL_LOG|${line}"; done; then
            emit "ERR|git pull gagal, cek koneksi atau ada conflict"
            exit 0
        fi
        AFTER=$(git rev-parse HEAD 2>/dev/null)
        if [ "$BEFORE" = "$AFTER" ]; then
            emit "PULL_DONE|ALREADY_LATEST|Udah di commit terbaru: ${AFTER:0:7}"
        else
            COUNT=$(git rev-list "${BEFORE}..${AFTER}" --count 2>/dev/null || echo 1)
            NEWMSG=$(git log -1 --format='%s' 2>/dev/null | head -c 80)
            emit "PULL_DONE|UPDATED|${COUNT} commit baru • ${AFTER:0:7} • ${NEWMSG}"
        fi
        ;;

    # sync dots/ ke ~/.config/ (rsync, bukan destructive delete)
    sync)
        TARGET="${2:-$CONFIG_DIR}"
        emit "SYNC_START|Syncing dots ke ${TARGET}..."

        # sync quickshell
        if rsync -a --delete \
            "$DOTS_SRC/quickshell/" \
            "$TARGET/quickshell/" 2>&1 | head -n 50 | while IFS= read -r l; do emit "SYNC_LOG|$l"; done; then
            emit "SYNC_OK|quickshell"
        else
            emit "SYNC_WARN|quickshell rsync exit non-zero (mungkin partial)"
        fi

        # sync hypr (tanpa --delete biar keybind custom tidak terhapus)
        mkdir -p "$TARGET/hypr/lua"
        if rsync -a \
            "$DOTS_SRC/hypr/" \
            "$TARGET/hypr/" 2>&1 | head -n 20 | while IFS= read -r l; do emit "SYNC_LOG|$l"; done; then
            emit "SYNC_OK|hypr"
        else
            emit "SYNC_WARN|hypr rsync exit non-zero"
        fi

        # sync kitty
        if rsync -a \
            "$DOTS_SRC/kitty/" \
            "$TARGET/kitty/" 2>&1 | head -n 10 | while IFS= read -r l; do emit "SYNC_LOG|$l"; done; then
            emit "SYNC_OK|kitty"
        else
            emit "SYNC_WARN|kitty rsync exit non-zero"
        fi

        # sync phantomshell state dir
        mkdir -p "$TARGET/phantomshell"
        if rsync -a \
            "$DOTS_SRC/phantomshell/presets/" \
            "$TARGET/phantomshell/presets/" 2>&1 | head -n 10 | while IFS= read -r l; do emit "SYNC_LOG|$l"; done; then
            emit "SYNC_OK|phantomshell/presets"
        fi

        emit "SYNC_DONE|Sync selesai ke ${TARGET}"
        ;;

    # pull + sync sekaligus, lalu reload quickshell
    pull-sync)
        TARGET="${2:-$CONFIG_DIR}"
        # jalankan pull dulu
        "$0" pull
        # lalu sync
        "$0" sync "$TARGET"
        emit "RELOAD_START|Reloading Quickshell..."
        # soft reload qs jika sedang berjalan
        if command -v qs &>/dev/null; then
            qs ipc call phantom reloadShell 2>/dev/null || true
        fi
        emit "RELOAD_DONE|Phantomshell diupdate dan direload"
        ;;

    # tampilkan status git singkat
    status)
        cd "$REPO_ROOT"
        BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
        COMMIT=$(git rev-parse HEAD 2>/dev/null)
        DIRTY=$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')
        MSG=$(git log -1 --format='%s' 2>/dev/null | head -c 80)
        DATE=$(git log -1 --format='%ar' 2>/dev/null)
        emit "STATUS|${BRANCH}|${COMMIT:0:7}|${DIRTY}|${MSG}|${DATE}"
        ;;

    *)
        cat <<EOF
phantom-sync — phantomshell updater & sync tool
usage:
  phantom-sync status           tampilkan git status repo
  phantom-sync check-remote     cek update di github tanpa pull
  phantom-sync pull             tarik commit terbaru (git pull --rebase)
  phantom-sync sync [target]    rsync dots/ ke ~/.config/ (default)
  phantom-sync pull-sync        pull + sync + reload qs sekaligus
EOF
        ;;
esac
